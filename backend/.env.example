# Copy this file to `.env` and fill in the values. Never commit the real `.env`.

# Required: Groq API key for the LLM call.
GROQ_API_KEY=your_groq_api_key_here

# Optional: URL of a running Embedding API. If unset, the backend embeds
# in-process via ChromaDB's default function instead of calling out.
# EMBEDDING_API_URL=http://localhost:8001

# Guard for the indexing endpoint. Set to "true" ONLY when (re)building the
# vector index; leave false in normal operation and in production.
ALLOW_INDEXING=false

# Number of reverse proxies in front of the app that append to X-Forwarded-For.
# Used to find the real client IP for rate limiting. Verify against your host.
TRUSTED_PROXY_COUNT=1

# true returns the raw retrieved chunks in /api/chat responses. Keep false in
# production: it exposes source-document text to anyone who calls the API.
DEBUG_CONTEXT=false
