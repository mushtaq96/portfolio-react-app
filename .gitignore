# Frontend dependencies
frontend/node_modules
frontend/build
*/node_modules
*/.pnp
*.pnp.js


# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python virtual environments
backend/.venv/
venv/
ENV/
env/

# Python bytecode cache
__pycache__/
*.py[cod]
*.pyo

# Coverage and test output (Python)
htmlcov/
*.coverage
*.pyc
*.pyo

# Logs
*.log

# ChromaDB persistent storage
backend/.chroma_db/

# Document storage — contains PII (CV/Lebenslauf). Keep local only, NEVER commit.
backend/.documents/

# Yarn Berry (v2+) artifacts. CI uses Yarn 1 with yarn.lock v1; don't mix them.
frontend/.yarn/
frontend/.yarnrc.yml

# Personal work notes — contain employer-internal detail. Never commit or publish.
Daily Learnings*.docx

# Environment variables file
.env